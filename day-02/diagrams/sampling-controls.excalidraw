  },
  {
   "id": "el191",
   "type": "text",
   "x": 0,
   "y": 1460,
   "width": 1379.4,
   "height": 27.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 898417016,
   "version": 1,
   "versionNonce": 1181082056,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Top-k = a fixed-size shortlist.   Top-p = a shortlist that shrinks when the model is sure and grows when it isn't.",
   "originalText": "Top-k = a fixed-size shortlist.   Top-p = a shortlist that shrinks when the model is sure and grows when it isn't.",
   "fontSize": 22,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "el192",
   "type": "text",
   "x": 0,
   "y": 1500,
   "width": 1148.4,
   "height": 22.5,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1456285509,
   "version": 1,
   "versionNonce": 256945034,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "OpenAI's API has temperature, top_p and max tokens but no top_k. Some other APIs do (e.g. Claude Haiku 4.5, Gemini).",
   "originalText": "OpenAI's API has temperature, top_p and max tokens but no top_k. Some other APIs do (e.g. Claude Haiku 4.5, Gemini).",
   "fontSize": 18,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
