   "versionNonce": 599671631,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "After attention, each token's vector goes through a small network on its own.",
   "originalText": "After attention, each token's vector goes through a small network on its own.",
   "fontSize": 19,
