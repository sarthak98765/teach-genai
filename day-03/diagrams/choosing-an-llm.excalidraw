      "versionNonce": 464368886,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Cost  =  input tokens / 1M  ×  input price   +   output tokens / 1M  ×  output price",
      "originalText": "Cost  =  input tokens / 1M  ×  input price   +   output tokens / 1M  ×  output price",
