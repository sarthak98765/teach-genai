      "link": null,
      "locked": false
    },
    {
      "id": "el58",
      "type": "text",
      "x": 25,
      "y": 1615,
      "width": 534.6,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2102398845,
      "version": 1,
      "versionNonce": 95272978,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Leaderboards can mislead you because:\n\n• test questions may have leaked into training data\n• their task is not your task (your docs, your format,\n   your language)\n• models get tuned to score well on popular benchmarks\n• a 1–2 point gap is often noise\n• most don't show cost or latency",
      "originalText": "Leaderboards can mislead you because:\n\n• test questions may have leaked into training data\n• their task is not your task (your docs, your format,\n   your language)\n• models get tuned to score well on popular benchmarks\n• a 1–2 point gap is often noise\n• most don't show cost or latency",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
