      "frameId": null,
      "roundness": null,
      "seed": 1585550870,
      "version": 1,
      "versionNonce": 1078561972,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "So build your own mini eval:\n\n1. collect 20–50 real examples with correct answers\n2. run every candidate model on them\n3. record accuracy, cost and latency\n4. pick the cheapest model that passes your bar\n5. re-run it when models or prompts change",
      "originalText": "So build your own mini eval:\n\n1. collect 20–50 real examples with correct answers\n2. run every candidate model on them\n3. record accuracy, cost and latency\n4. pick the cheapest model that passes your bar\n5. re-run it when models or prompts change",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
