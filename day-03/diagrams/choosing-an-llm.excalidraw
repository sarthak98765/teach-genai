      "versionNonce": 1198611526,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "More context is not free: every extra token adds cost and latency, and a huge window doesn't mean the model uses all of it well.",
      "originalText": "More context is not free: every extra token adds cost and latency, and a huge window doesn't mean the model uses all of it well.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
