    {
      "id": "el39",
      "type": "text",
      "x": 245.5999999999999,
      "y": 960.0,
      "width": 1108.8000000000002,
      "height": 30.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
