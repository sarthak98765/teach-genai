    },
    {
      "id": "el60",
      "type": "text",
      "x": 865,
      "y": 1615,
      "width": 504.90000000000003,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
