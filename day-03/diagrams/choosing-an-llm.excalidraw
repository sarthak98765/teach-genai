      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "el40",
      "type": "text",
      "x": 0,
      "y": 1040,
      "width": 715.0000000000001,
      "height": 100.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 134766441,
      "version": 1,
      "versionNonce": 847761489,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Example (illustrative prices: $0.50 in, $2.00 out per 1M):\n10,000 input tokens   →  $0.005\n 1,000 output tokens   →  $0.002\nper request = $0.007     ×  100,000 requests/month  =  $700/month",
      "originalText": "Example (illustrative prices: $0.50 in, $2.00 out per 1M):\n10,000 input tokens   →  $0.005\n 1,000 output tokens   →  $0.002\nper request = $0.007     ×  100,000 requests/month  =  $700/month",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
