      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Benefits\n+ Ship fast: no GPUs, no model serving\n+ Strong models for hard reasoning, coding, tools\n+ Provider handles capacity and serving\n+ Scale up without buying hardware\n+ Swap models easily to compare",
      "originalText": "Benefits\n+ Ship fast: no GPUs, no model serving\n+ Strong models for hard reasoning, coding, tools\n+ Provider handles capacity and serving\n+ Scale up without buying hardware\n+ Swap models easily to compare",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
