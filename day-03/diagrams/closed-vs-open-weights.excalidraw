      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Add to both: engineering time, idle capacity, retries on wrong answers.\nOnly compare options that hit the same quality, latency and uptime.",
      "originalText": "Add to both: engineering time, idle capacity, retries on wrong answers.\nOnly compare options that hit the same quality, latency and uptime.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
