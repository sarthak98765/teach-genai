      "locked": false
    },
    {
      "id": "el52",
      "type": "text",
      "x": 865,
      "y": 1320,
      "width": 524.7,
      "height": 135.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
