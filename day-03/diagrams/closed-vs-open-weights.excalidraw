      "version": 1,
      "versionNonce": 1252465721,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Open-weight ≠ open-source: the weights are released, but training data and code often aren't.\nLicences differ per model (Apache 2.0 vs custom terms like Llama's). Check the exact version.",
      "originalText": "Open-weight ≠ open-source: the weights are released, but training data and code often aren't.\nLicences differ per model (Apache 2.0 vs custom terms like Llama's). Check the exact version.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
