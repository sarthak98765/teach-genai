      "roundness": null,
      "seed": 1878815205,
      "version": 1,
      "versionNonce": 1109101754,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Benefits\n+ Run anywhere: laptop, private cloud, on-prem\n+ Customise: fine-tune, quantise (licence permitting)\n+ Prompts can stay inside your network\n+ Can be cheaper at high, steady volume\n+ No lock-in to one inference provider",
      "originalText": "Benefits\n+ Run anywhere: laptop, private cloud, on-prem\n+ Customise: fine-tune, quantise (licence permitting)\n+ Prompts can stay inside your network\n+ Can be cheaper at high, steady volume\n+ No lock-in to one inference provider",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "el51",
      "type": "rectangle",
