      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Limitations\n− Pay for every token, forever\n− Can't change the weights (fine-tune only if offered)\n− Provider risk: price changes, deprecations, outages\n− Data leaves your network: check retention + terms\n− Can't run their model on your own servers",
      "originalText": "Limitations\n− Pay for every token, forever\n− Can't change the weights (fine-tune only if offered)\n− Provider risk: price changes, deprecations, outages\n− Data leaves your network: check retention + terms\n− Can't run their model on your own servers",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
