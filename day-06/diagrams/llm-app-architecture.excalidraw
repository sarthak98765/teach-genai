      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 POST /chat endpoint\n\u2022 Validate input, check auth\n\u2022 Add system prompt + context\n\u2022 Load API key from .env\n\u2022 Call the model API\n\u2022 Handle errors, log tokens + time\n\nPython FastAPI \u00b7 Node\n(today: main.py)",
      "originalText": "\u2022 POST /chat endpoint\n\u2022 Validate input, check auth\n\u2022 Add system prompt + context\n\u2022 Load API key from .env\n\u2022 Call the model API\n\u2022 Handle errors, log tokens + time\n\nPython FastAPI \u00b7 Node\n(today: main.py)",
      "fontSize": 19,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
