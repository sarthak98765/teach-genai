   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "THE MATHS  (made-up prices, just to show the idea)\nregular input $1 per million tokens  \u00b7  cached input $0.10 per million\n8,000 repeated tokens \u00d7 1,000 requests = 8 million tokens\nno caching: $8.00     every call a hit: $0.80     saved: 90%",
   "originalText": "THE MATHS  (made-up prices, just to show the idea)\nregular input $1 per million tokens  \u00b7  cached input $0.10 per million\n8,000 repeated tokens \u00d7 1,000 requests = 8 million tokens\nno caching: $8.00     every call a hit: $0.80     saved: 90%",
   "fontSize": 18,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "el106",
   "autoResize": true,
   "lineHeight": 1.25
  },
