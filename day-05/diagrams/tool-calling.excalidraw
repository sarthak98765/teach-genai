      "updated": 1,
      "link": null,
      "locked": false,
      "text": "{\n  \"name\": \"search_products\",\n  \"description\": \"Search the ShopKart catalogue. Use it when the\n    customer asks about products, prices or stock. Do NOT use\n    it for order status. Returns up to 5 matches with price\n    in INR and stock per size.\",\n  \"parameters\": {\n    \"query\":    {\"type\": \"string\", \"description\": \"e.g. 'blue hoodie'\"},\n    \"category\": {\"enum\": [\"tops\", \"bottoms\", \"shoes\", \"bags\"]}\n  }\n}",
      "originalText": "{\n  \"name\": \"search_products\",\n  \"description\": \"Search the ShopKart catalogue. Use it when the\n    customer asks about products, prices or stock. Do NOT use\n    it for order status. Returns up to 5 matches with price\n    in INR and stock per size.\",\n  \"parameters\": {\n    \"query\":    {\"type\": \"string\", \"description\": \"e.g. 'blue hoodie'\"},\n    \"category\": {\"enum\": [\"tops\", \"bottoms\", \"shoes\", \"bags\"]}\n  }\n}",
      "fontSize": 15,
